#: invenio_stats/errors.py:71
#, python-format
msgid "Unknown statistic '%(query_name)s'"
msgstr "สถิติที่ไม่รู้จัก '%(query_name)s'"

#: invenio_stats/views.py:60
#, python-brace-format
msgid ""
"Invalid Input. It should be of the form { STATISTIC_NAME: { \"stat\": "
"STAT_TYPE, \"params\": STAT_PARAMS }}"
msgstr ""
"ข้อมูลไม่ถูกต้อง ควรอยู่ในรูปแบบ { STATISTIC_NAME: { \"stat\": STAT_TYPE, "
"\"params\": STAT_PARAMS }}"

#: invenio_stats/views.py:76
#, python-format
msgid ""
"You do not have a permission to query the statistic \"%(stat)s\" with those "
"parameters"
msgstr "คุณไม่มีสิทธิ์ในการสอบถามค่าสถิติ \"%(stat)s\" ด้วยพารามิเตอร์เหล่านั้น"
